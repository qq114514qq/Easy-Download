<Window x:Class="EasyDownload.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EasyDownload"
        Width="1120" Height="720" MinWidth="860" MinHeight="520"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource NavBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="EasyDownload" FontSize="14" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE706;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource NavButton}" Click="Theme_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="切换主题" />
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource NavButton}" Click="Min_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource NavButton}" Click="Max_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource NavButton}" Click="Close_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" Background="{DynamicResource NavBrush}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="NavHome" Grid.Row="0" Style="{StaticResource NavButton}" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                <TextBlock Text="首页" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavDown" Grid.Row="1" Style="{StaticResource NavButton}" Click="Nav_Click"
                                Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                <TextBlock Text="下载" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSet" Grid.Row="2" Style="{StaticResource NavButton}" Click="Nav_Click"
                                Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                <TextBlock Text="设置" Margin="12,0,0,0" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Row="4" Text="EasyDownload v1.0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,4" />
                    </Grid>
                </Border>

                <!-- 内容 -->
                <ContentControl x:Name="Host" Grid.Column="1" />
            </Grid>
        </Grid>
    </Border>
</Window>
