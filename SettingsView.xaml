<UserControl x:Class="EasyDownload.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

            <!-- 外观 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="选择浅色或深色主题" FontSize="12" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LightBtn" Content="浅色" Width="100" Click="Light_Click" />
                        <Button x:Name="DarkBtn" Content="深色" Width="100" Margin="8,0,0,0" Click="Dark_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 下载 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="下载" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Text="单文件最大线程数" FontSize="14" />
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ThreadSlider" Grid.Column="0" Minimum="1" Maximum="32"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Thread_Changed" />
                        <TextBlock x:Name="ThreadText" Grid.Column="1" Text="32" Margin="12,0,0,0" />
                    </Grid>

                    <TextBlock Text="同时下载的文件数" FontSize="14" />
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="ConcurrentSlider" Grid.Column="0" Minimum="1" Maximum="8"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Concurrent_Changed" />
                        <TextBlock x:Name="ConcurrentText" Grid.Column="1" Text="4" Margin="12,0,0,0" />
                    </Grid>

                    <CheckBox x:Name="ThrottleSwitch" Content="自动限速（约 1 MB/s）"
                              Style="{StaticResource ToggleSwitch}" Margin="0,6" />
                    <CheckBox x:Name="ResumeSwitch" Content="启用断点续传"
                              Style="{StaticResource ToggleSwitch}" Margin="0,6" />
                    <CheckBox x:Name="ConfirmSwitch" Content="下载前先问我"
                              Style="{StaticResource ToggleSwitch}" Margin="0,6" />

                    <TextBlock Text="下载目录" FontSize="14" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Grid.Column="0" />
                        <Button Grid.Column="1" Content="打开" Margin="8,0,0,0" Click="OpenFolder_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 保存 -->
            <StackPanel Orientation="Horizontal">
                <Button Content="保存设置" Style="{StaticResource AccentButton}" Click="Save_Click" />
                <TextBlock x:Name="TipText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
